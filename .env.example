# Database (example)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Database connection requirement
DB_REQUIRED=true
DB_INIT_RETRIES=5
DB_INIT_RETRY_DELAY_MS=2000

# SMTP / Email verification
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Patren AI <noreply@gokaitech.my.id>"

# OTP settings
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
OTP_HASH_SECRET=
OTP_BLOCK_MINUTES=15
OTP_RESEND_COOLDOWN_MINUTES=1

# Pollinations AI
POLLINATIONS_ENDPOINT=https://gen.pollinations.ai/v1/chat/completions
POLLINATIONS_MODEL=openai
POLLINATIONS_API_KEY=

# Timeouts and throttles (ms)
AI_TIMEOUT_MS=30000
BOT_THROTTLE_MS=1000

# WhatsApp session dir
WA_SESSION_DIR=./.wadata
USE_BAILEYS=true

# Allowlist of WhatsApp IDs (comma-separated)
ALLOWED_WA_IDS=

# Logging
LOG_LEVEL=info
